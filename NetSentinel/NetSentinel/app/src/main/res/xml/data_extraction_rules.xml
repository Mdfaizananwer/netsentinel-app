<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup is false and this intentionally excludes everything: scan results, capture
     sessions and device inventory must never leave the device via auto backup/transfer. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
